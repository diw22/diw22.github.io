{
  "name": "kraftwerk-bot-page",
  "private": true,
  "description": "Builds app.js, the Kraftwerk Bot page, from src/. three.js stays external: the page's import map points it at the site's vendored copy.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --format=esm --target=es2020 --jsx=automatic --minify --external:three --external:three/* --define:process.env.NODE_ENV=\\\"production\\\" --legal-comments=linked --outfile=app.js"
  },
  "devDependencies": {
    "@react-three/fiber": "9.8.2",
    "esbuild": "0.25.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
